# DFO Open API key (https://api.neople.co.kr / dfoneople developers)
# Recuerda añadirla también como variable de entorno en Vercel (Settings → Environment Variables).
DFO_API_KEY=

# Opcional: si se expone, el cliente puede caer a la API de Neople directamente
# cuando el proxy /df no responde (ej. fallo de la función serverless en Vercel).
# Se envía en cada petición, así que queda visible en el bundle público.
# VITE_DFO_API_KEY=